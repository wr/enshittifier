<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle 2 appcast for Enshittifier.

  Live URL: https://wr.github.io/enshittifier/appcast.xml
    (served from the gh-pages branch root).

  Each release tagged `vX.Y.Z` produces a DMG that gets attached to a
  GitHub Release; `scripts/release.sh X.Y.Z` then edits this file (in a
  gh-pages worktree) to prepend a new `<item>` with the version, download
  URL, file length, and EdDSA signature produced by Sparkle's `sign_update`.

  Don't hand-edit live entries unless you also update their
  sparkle:edSignature — Sparkle will reject anything where the signature
  doesn't match the bytes it downloads.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
                  xmlns:dc="http://purl.org/dc/elements/1.1/">
    <channel>
        <title>Enshittifier</title>
        <link>https://wr.github.io/enshittifier/appcast.xml</link>
        <description>Updates for Enshittifier</description>
        <language>en</language>
        <!-- Releases inserted above this marker by scripts/release.sh. -->
        <!-- ENSHITTIFIER_APPCAST_INSERT_BEFORE -->
    </channel>
</rss>
