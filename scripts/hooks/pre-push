#!/usr/bin/env bash
# Pre-push hook: runs scripts/check.sh before allowing a push of gh-pages.
#
# Scoped: only fires when the ref being pushed is gh-pages — pushes to
# main (the Mac-app source) skip it. Skips when the only file in the
# diff is appcast.xml (that's the release script on `main`,
# scripts/release.sh, pushing an auto-generated feed). Skips if the
# current worktree doesn't have site files (e.g., the hook runs from
# the main-branch worktree by accident).
#
# Bypass: git push --no-verify

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

zero="0000000000000000000000000000000000000000"
should_run=0
non_appcast_change=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_sha" || "$local_sha" == "$zero" ]] && continue
  # Only the gh-pages ref is gated.
  [[ "$remote_ref" != "refs/heads/gh-pages" ]] && continue
  should_run=1

  if [[ "$remote_sha" == "$zero" ]]; then
    base="$(git merge-base "$local_sha" origin/gh-pages 2>/dev/null || true)"
    if [[ -n "$base" ]]; then
      files="$(git diff --name-only "$base" "$local_sha")"
    else
      files="$(git show --pretty='' --name-only "$local_sha")"
    fi
  else
    files="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi

  while IFS= read -r f; do
    [[ -z "$f" || "$f" == "appcast.xml" ]] && continue
    non_appcast_change=1
  done <<< "$files"
done

[[ $should_run -eq 0 ]] && exit 0

if [[ $non_appcast_change -eq 0 ]]; then
  printf '\033[90mpre-push: only appcast.xml changed — skipping checks (release script)\033[0m\n'
  exit 0
fi

if [[ ! -f "index.html" || ! -x "scripts/check.sh" ]]; then
  printf '\033[33mpre-push: site files not in this worktree — skipping checks\033[0m\n'
  exit 0
fi

printf '\033[1m▸ pre-push: running ./scripts/check.sh\033[0m\n'
printf '\033[90m  (bypass with: git push --no-verify)\033[0m\n'
exec ./scripts/check.sh
